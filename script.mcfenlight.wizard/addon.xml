<?xml version="1.0" encoding="UTF-8"?>
<addon id="script.mcfenlight.wizard" name="McFenlight Wizard" version="1.0.0" provider-name="McMoobud">
    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
    </requires>
    <extension point="xbmc.python.script" library="default.py">
        <provides>executable</provides>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary lang="en">One-click McFenlight setup wizard</summary>
        <description lang="en">Installs McFenlight, CocoScrapers, and configures Trakt and Real-Debrid automatically.</description>
        <platform>all</platform>
    </extension>
</addon>

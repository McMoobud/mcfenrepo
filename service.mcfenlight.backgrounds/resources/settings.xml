<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<settings version="1">
    <section id="service.mcfenlight.backgrounds">
        <category id="general" label="Backgrounds">
            <group id="1">
                <setting id="set_skin" type="boolean" label="Force Confluence skin on boot">
                    <level>0</level>
                    <default>true</default>
                    <control type="toggle" />
                </setting>
                <setting id="source_mode" type="string" label="Source">
                    <level>0</level>
                    <default>auto</default>
                    <constraints>
                        <options>
                            <option label="Auto (Emby if available, else TMDB)">auto</option>
                            <option label="Emby library only">emby</option>
                            <option label="TMDB only">tmdb</option>
                        </options>
                    </constraints>
                    <control type="spinner" format="string" />
                </setting>
                <setting id="category" type="string" label="TMDB category">
                    <level>0</level>
                    <default>trending</default>
                    <constraints>
                        <options>
                            <option label="Trending">trending</option>
                            <option label="In Cinemas (box office)">cinemas</option>
                            <option label="Popular (blockbusters)">popular</option>
                        </options>
                    </constraints>
                    <dependencies>
                        <dependency type="visible" setting="source_mode" operator="!is">emby</dependency>
                    </dependencies>
                    <control type="spinner" format="string" />
                </setting>
                <setting id="image_count" type="integer" label="Number of images per boot">
                    <level>0</level>
                    <default>15</default>
                    <constraints>
                        <minimum>1</minimum>
                        <step>1</step>
                        <maximum>30</maximum>
                    </constraints>
                    <control type="slider" format="integer">
                        <popup>false</popup>
                    </control>
                </setting>
            </group>
        </category>
    </section>
</settings>

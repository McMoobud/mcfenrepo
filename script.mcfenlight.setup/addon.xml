<?xml version="1.0" encoding="UTF-8"?>
<addon id="script.mcfenlight.setup" name="McFenlight Setup" version="1.0.1" provider-name="McMoobud">
    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
    </requires>
    <extension point="xbmc.python.script" library="default.py">
        <provides>executable</provides>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary lang="en">One-click McFenlight setup with TorBox</summary>
        <description lang="en">Installs McFenlight, CocoScrapers, and configures Trakt and TorBox automatically. For fresh Kodi installs.</description>
        <platform>all</platform>
            <assets>
                <icon>icon.png</icon>
            </assets>
    </extension>
</addon>

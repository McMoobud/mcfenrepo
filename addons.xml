<?xml version="1.0" encoding="UTF-8"?>
<addons>
    <addon id="repository.mcfenlight" name="McFenlight Repository" version="1.0.3" provider-name="McMoobud">
        <requires>
            <import addon="xbmc.addon" version="21.0.0"/>
        </requires>
        <extension point="xbmc.addon.repository" name="McFenlight Repository">
            <dir minversion="21.0.0">
                <info compressed="false">https://mcmoobud.github.io/mcfenrepo/addons.xml</info>
                <checksum>https://mcmoobud.github.io/mcfenrepo/addons.xml.md5</checksum>
                <datadir zipped="true">https://mcmoobud.github.io/mcfenrepo/</datadir>
            </dir>
        </extension>
        <extension point="xbmc.addon.metadata">
            <summary lang="en">McFenlight Repository</summary>
            <description lang="en">Install and update the McFenlight addon.</description>
            <platform>all</platform>
        </extension>
    </addon>
    <addon id="plugin.video.mcfenlight" name="McFenlight" provider-name="McMoobud" version="2.2.30">
        <requires>
            <import addon="xbmc.python" version="3.0.0"/>
            <import addon="script.module.pil" version="1.1.7"/>
            <import addon="script.module.requests" version="2.19.1"/>
        </requires>
        <extension point="xbmc.python.pluginsource" library="resources/lib/fenlight.py">
            <provides>video</provides>
        </extension>
        <extension point="xbmc.service" library="resources/lib/service.py"/>
        <extension point="xbmc.python.module" library="resources/lib/"/>
        <extension point="xbmc.addon.metadata">
            <reuselanguageinvoker>true</reuselanguageinvoker>
            <summary lang="en">Access your content from Easynews and Debrid Clouds.</summary>
            <description lang="en">This add-on is intended for advanced Kodi users only. You must own the content of any media you play through this addon. This is an English language only add-on.</description>
            <platform>all</platform>
    		<disclaimer lang="en">The author of this addon does not host any of the content which is found and has no affiliation with any of the content providers.</disclaimer>
            <license/>
            <assets>
                <icon>icon.png</icon>
                <fanart>fanart.png</fanart>
            </assets>
            <news>INFO: For latest changes see Changelog within Tools of add-on.</news>
        </extension>
    </addon>
    <addon id="script.mcfenlight.setup" name="McFenlight Setup" version="1.1.0" provider-name="McMoobud">
        <requires>
            <import addon="xbmc.python" version="3.0.0"/>
        </requires>
        <extension point="xbmc.python.script" library="default.py">
            <provides>executable</provides>
        </extension>
        <extension point="xbmc.addon.metadata">
            <summary lang="en">One-click McFenlight full install</summary>
            <description lang="en">Full one-click setup for fresh Kodi installs: McFenlight, CocoScrapers, dependencies, TorBox (pre-configured), the Confluence skin, dynamic movie backgrounds, and optional Trakt and Emby.</description>
            <platform>all</platform>
                <assets>
                    <icon>icon.png</icon>
                </assets>
        </extension>
    </addon>
    <addon id="service.mcfenlight.backgrounds" name="McFenlight Backgrounds" version="1.0.4" provider-name="McMoobud">
        <requires>
            <import addon="xbmc.python" version="3.0.0" />
        </requires>
        <extension point="xbmc.service" library="service.py" start="startup" />
        <extension point="xbmc.addon.metadata">
            <summary lang="en">Custom splash screen and dynamic movie backgrounds for McFenlight</summary>
            <description lang="en">Installs a custom Kodi splash screen and refreshes the home background on every boot with random movie art — from your Emby library if present, otherwise from TMDB (Trending / In Cinemas / Popular).</description>
            <platform>all</platform>
            <assets>
                <icon>icon.png</icon>
            </assets>
        </extension>
    </addon>
    <addon id="script.mcfenlight.emby" name="McFenlight Emby Setup" version="1.0.1" provider-name="McMoobud">
        <requires>
            <import addon="xbmc.python" version="3.0.0"/>
        </requires>
        <extension point="xbmc.python.script" library="default.py">
            <provides>executable</provides>
        </extension>
        <extension point="xbmc.addon.metadata">
            <summary lang="en">Install Emby for Kodi</summary>
            <description lang="en">Installs the Emby repository and Emby for Kodi addon. Emby will run its own setup wizard after Kodi restarts.</description>
            <platform>all</platform>
                <assets>
                    <icon>icon.png</icon>
                </assets>
        </extension>
    </addon>
</addons>
